# ============================================================
# Sanitized merge fragment for an operator-managed Caddyfile.
#
# This is not a complete production Caddyfile. The active Caddyfile is the
# source of truth and may already declare common_security,
# inline_style_static_csp, same_origin_web_csp, onekarlo_portfolio_csp,
# and private_noindex. Do not replace that file or blindly append this
# fragment; merge one reviewed onekarlo.com site block into the existing
# declaration instead.
#
# The existing onekarlo_portfolio_csp policy includes style-src
# 'self' 'unsafe-inline' https://fonts.googleapis.com and
# style-src-attr 'none'. The complete policy is validated in the Caddy
# container; deploy.sh only checks this fragment's standalone formatting.
# ============================================================

onekarlo.com {
	root * /srv/onekarlo-com

	import common_security
	import onekarlo_portfolio_csp
	import private_noindex

	@html path / /index.html
	header @html >Cache-Control "public, max-age=300, must-revalidate"

	@versioned_assets path /assets/*
	header @versioned_assets >Cache-Control "public, max-age=31536000, immutable"

	file_server {
		hide data config storage database db uploads backups .git .env* *.db *.sqlite *.sqlite3
	}
}
