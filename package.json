{
  "name": "onekarlo-com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "deploy": "./deploy.sh",
    "verify:workers": "test -s dist/index.html && test -f dist/404.html && test -f dist/_headers",
    "preview:workers": "rm -rf node_modules/.cache/wrangler && wrangler versions upload ./dist --preview-alias staging",
    "deploy:workers": "rm -rf node_modules/.cache/wrangler && wrangler deploy ./dist"
  },
  "dependencies": {
    "motion": "13.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wrangler": "4.127.1"
  }
}
